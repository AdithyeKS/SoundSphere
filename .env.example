# Django Settings
SECRET_KEY=your-production-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database (Leave DATABASE_URL blank to use SQLite by default)
# DATABASE_URL=postgresql://user:password@host:port/dbname
USE_MYSQL=False
MYSQL_DATABASE=soundsphere_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Razorpay / Stripe Keys (Placeholders)
RAZORPAY_KEY_ID=rzp_test_SoundSphereMockKey
RAZORPAY_KEY_SECRET=mock_secret_key_123456789

# Email Notification Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SoundSphere Support <noreply@soundsphere.com>
